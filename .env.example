# Trust Agent — empaquetado local single-node (constitution VII).
# Copia este archivo a .env y ajusta los secretos:
#   cp .env.example .env
#   # genera secretos fuertes:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"        # DEVICE_TOKEN_SECRET
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"  # VAULT_KEK_B64

# --- PostgreSQL (contenedor db) -------------------------------------------
# Superusuario del contenedor (solo migraciones/bootstrap; la app NUNCA
# conecta como postgres — siempre trust_app, sujeto a RLS).
POSTGRES_PASSWORD=trustlocal

# --- Keycloak (contenedor idp) --------------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-keycloak-admin

# --- Secretos del control plane (fail-closed: sin ellos NO arranca) -------
# Firma HS256 de device tokens (32+ bytes aleatorios).
TRUST_DEVICE_TOKEN_SECRET=change-me-device-token-secret
# KEK del vault (envelope encryption, 32 bytes base64). NUNCA en la DB.
TRUST_VAULT_KEK_B64=change-me-vault-kek-b64

# --- Token de operaciones del proveedor (spec 004) -------------------------
# Bearer de /api/admin/tenants* (platform_admin NO es rol de tenant).
TRUST_PROVIDER_TOKEN=change-me-provider-token
