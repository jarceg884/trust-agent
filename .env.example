# =============================================================================
# Trust Agent — plantilla de entorno COMPLETA (t_b62edff2, "desplegable donde sea")
# =============================================================================
# Copia este archivo a .env y ajusta SOLO lo que necesites:
#   cp .env.example .env
#
# VÍA RÁPIDA (dev o servidor): scripts/setup.sh genera los secretos que
# falten y deriva todas las URLs públicas desde TRUST_PUBLIC_BASE_URL:
#   TRUST_PUBLIC_BASE_URL=http://TU-IP-O-DOMINIO scripts/setup.sh
#
# VÍA MANUAL: edita a mano. En dev local NO hace falta tocar nada salvo
# correr setup.sh (o generar los secretos fail-closed a mano, ver abajo).
# En un servidor propio cambia: TRUST_PUBLIC_BASE_URL + las URLs/puertos
# públicos de la sección 2 (o deja que setup.sh las derive).
#
# REGLA DE ORO (constitution IV): el VALOR de todo secreto vive SOLO en
# este archivo ya copiado (.env, gitignored). NADA de secretos en el repo.

# =============================================================================
# 1) SECRETOS (fail-closed: sin valores reales el API NO arranca)
# =============================================================================

# --- PostgreSQL (contenedor db) -------------------------------------------
# Superusuario del contenedor (solo migraciones/bootstrap; la app NUNCA
# conecta como postgres — siempre trust_app, sujeto a RLS).
POSTGRES_PASSWORD=change-me-postgres
# Roles canónicos (los crea db/scripts/bootstrap.sh en el primer arranque
# del volumen). Sin comillas simples en los valores (interpolación SQL).
TRUST_APP_PASSWORD=change-me-trust-app
TRUST_MIGRATOR_PASSWORD=change-me-trust-migrator

# --- Keycloak (contenedor idp) --------------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-keycloak-admin

# --- Secretos del control plane (fail-closed: sin ellos NO arranca) -------
# Firma HS256 de device tokens (32+ bytes aleatorios):
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TRUST_DEVICE_TOKEN_SECRET=change-me-device-token-secret
# KEK del vault (envelope encryption, 32 bytes base64). NUNCA en la DB:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
TRUST_VAULT_KEK_B64=change-me-vault-kek-b64
# Clave privada RSA-2048 (PEM PKCS#8, base64) que FIRMA el governance bundle
# JWS RS256 de spec 019 (fail-closed: sin ella el API no arranca). Generar:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
# La pública correspondiente se publica en GET /.well-known/policy-jwks.json
# y se pinea junto al plugin (trust_agent_policy_pubkey.pem, dato público).
TRUST_POLICY_JWS_PRIVATE_KEY_B64=change-me-policy-jws-private-key
# Iss pineado en el payload del bundle (§5.2); el verificador lo comprueba
# si el env TRUST_POLICY_ISSUER está presente en el dispositivo.
TRUST_POLICY_JWS_ISSUER=https://trust-agent.control-plane/

# --- Operador del proveedor (spec 025) --------------------------------------
# El login del Provider Console es usuario+contraseña del super-user seedeado
# en ops.provider_operators. La contraseña one-time se genera al bootstrap y
# se loguea EXACTAMENTE una vez (docker logs <prefijo>-api). scripts/setup.sh
# la captura e imprime al final.
TRUST_PROVIDER_OPERATOR_USERNAME=provider-admin
# Opcional: pinea la contraseña inicial en vez de generarla (desatendido,
# p. ej. CI). Déjalo VACÍO en producción real.
# TRUST_PROVIDER_OPERATOR_INITIAL_PASSWORD=

# --- Break-glass DEPRECADO (spec 025, D-PS-06) ------------------------------
# SOLO para scripts de emergencia (provisioning por API, evidence scripts);
# la UI ya no lo usa. Sin operador seedeado, toda autenticación provider
# fail-closea.
TRUST_PROVIDER_TOKEN=change-me-provider-token

# =============================================================================
# 2) URLs Y PUERTOS PÚBLICOS (portabilidad "donde sea")
# =============================================================================
# MODO (a) DEV LOCAL — default, no toques nada: todo en 127.0.0.1 con los
#   puertos canónicos del runbook (55432/8080/8000/39989/3100/3200).
# MODO (b) SERVIDOR PROPIO — fija TRUST_PUBLIC_BASE_URL con la IP o dominio
#   público del servidor (http://203.0.113.10 o http://trust.tudominio.com)
#   y deja que scripts/setup.sh derive las URLs de abajo; o edítalas a mano.
#   Con HTTPS tras un proxy inverso, fija además cada *_URL pública con su
#   dominio TLS real y TRUST_COOKIE_SECURE=true (ver README §Modo servidor).

# Base pública de la que derivan todas las URLs (solo la usa setup.sh).
TRUST_PUBLIC_BASE_URL=http://127.0.0.1

# --- URLs públicas (las que ve el navegador) --------------------------------
# IdP/Keycloak — es también el issuer OIDC que el API acepta.
TRUST_IDP_PUBLIC_URL=http://127.0.0.1:8080
# Admin Console (redirect URI = esta URL + /auth/callback).
TRUST_CONSOLE_PUBLIC_URL=http://127.0.0.1:3100
# Link público de descarga de Hermes que el Admin Console muestra al cliente
# (spec 023). En un despliegue real suele ser el dominio público del API.
TRUST_DOWNLOAD_BASE_URL=http://127.0.0.1:8000

# --- URLs internas (server-side; con host networking SIEMPRE loopback) -----
# API vista por los BFF de las consoles y por el servicio migrate.
TRUST_API_BASE_URL=http://127.0.0.1:8000
# Keycloak Admin REST (provisioning de realms).
TRUST_KEYCLOAK_ADMIN_URL=http://127.0.0.1:8080
# Issuers OIDC aceptados por el API (lista separada por comas). El segundo
# (127.0.0.1:8908) es el IdP de test del smoke autorizado — en un servidor
# propio déjalo SOLO con tu URL pública.
TRUST_IDP_BASE_URLS=http://127.0.0.1:8080,http://127.0.0.1:8908
# Redirect URIs registradas en el cliente público OIDC de cada tenant:
# console + callback del helper trust-login del bundle (:8765, spec 023).
TRUST_OIDC_REDIRECT_URIS=http://127.0.0.1:3100/auth/callback,http://localhost:3100/auth/callback,http://127.0.0.1:8765/callback

# --- Puertos (dev = canónicos del runbook) ----------------------------------
TRUST_DB_PORT=55432
TRUST_IDP_PORT=8080
TRUST_API_PORT=8000
TRUST_CONSOLE_PORT=3100
TRUST_PROVIDER_CONSOLE_PORT=3200
TRUST_LITELLM_DOUBLE_PORT=39989
TRUST_LITELLM_PORT=4000            # proxy LiteLLM real (perfil `litellm`)
TRUST_LITELLM_DB_PORT=55433        # PostgreSQL dedicado del proxy real

# --- Binds -------------------------------------------------------------------
# TRUST_IDP_BIND: 127.0.0.1 en dev; 0.0.0.0 en un servidor propio para que
#   el navegador del cliente llegue al IdP por la URL pública (setup.sh lo
#   ajusta solo). La DB SIEMPRE queda en 127.0.0.1 (no se publica).
TRUST_IDP_BIND=127.0.0.1
# TRUST_API_HOST: bind del uvicorn del API. 127.0.0.1 en dev (solo proxy
#   inverso local); 0.0.0.0 en un servidor propio sin proxy inverso.
TRUST_API_HOST=127.0.0.1
# Cookies Secure: false SOLO sobre http local; true con HTTPS público.
TRUST_COOKIE_SECURE=false
# Prefijo de nombres de contenedor (default trust-agent). Cámbialo SOLO si
# corres dos stacks del piloto en el mismo host (p. ej. evidencia
# fresh-clone: TRUST_CONTAINER_PREFIX=ta2 + `docker compose -p ta2`).
TRUST_CONTAINER_PREFIX=trust-agent

# =============================================================================
# 3) PLANO DE CONTROL DE MODELOS (LiteLLM)
# =============================================================================
# Topología DEV (default): doble declarado de tests (D-GOV-15) — costo cero,
# sin credenciales. NO sirve para gobernar spend real.
# Topología PRODUCCIÓN (perfil `litellm`): proxy LiteLLM REAL con precios
# MaaS reales (litellm-real/config.yaml). Arranca con:
#   docker compose --profile litellm up -d
# y apunta aquí el control plane (valores de ejemplo con los puertos default):
TRUST_LITELLM_BASE_URL=http://127.0.0.1:39989
TRUST_LITELLM_MASTER_KEY=sk-master-test
# PostgreSQL dedicado del proxy real + su master key (perfil `litellm`):
LITELLM_DB_PASSWORD=change-me-litellm-db
LITELLM_MASTER_KEY=change-me-litellm-master-key
# Imagen del proxy real (pineada = requirements de litellm-real/).
LITELLM_IMAGE_TAG=v1.106.3

# --- Upstream MaaS (spec 018 §5, D-018-07) ----------------------------------
# Endpoint OpenAI-compatible del proveedor de modelos (Huawei Cloud MaaS en
# el piloto) y la key del proveedor ("Inforum" en la doc; el VALOR vive SOLO
# aquí). El refresh central reconcilia el catálogo contra GET {endpoint}/models.
# Vacío ⇒ el refresh degrada al chequeo de routing (nunca fail-open).
TRUST_MAAS_ENDPOINT=
TRUST_MAAS_API_KEY=
