# Admin Console — entorno local (constitution VII: local-first).
# Copiar a .env.local o exportar antes de `npm run dev`.

# Control plane (FastAPI, spec 003). Runbook: platform/README.md paso 3.
TRUST_API_BASE_URL=http://127.0.0.1:8000

# IdP OIDC (Keycloak). El realm por org es {base}/realms/{org_code}.
TRUST_IDP_BASE_URL=http://127.0.0.1:8080

# Cliente público registrado por el aprovisionamiento en cada realm
# (platform/app/tenants/provision.py: "trust-agent-web").
TRUST_OIDC_CLIENT_ID=trust-agent-web

# Redirect URI del console. Canónica: :3000 (default de oidc_redirect_uris
# del control plane). En este host el 3000 está ocupado por contenedores
# ajenos, por lo que el dev server corre en :3100 — el tenant debe tener
# esta URI registrada (TRUST_OIDC_REDIRECT_URIS del control plane al
# aprovisionar, D-AC-09).
TRUST_CONSOLE_REDIRECT_URI=http://127.0.0.1:3100/auth/callback
