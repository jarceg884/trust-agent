# Secretos reales — nunca al repo
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Entornos y locales
*.local
.DS_Store

# Logs y estado efímero
*.log
/tmp/

# Lock de serialización de migraciones (runtime, ADR 0001)
db/migrations/.versions.lock

# E2E spec 023 (hermes-download): homes de empleados de prueba con claves
# de dispositivo y tokens — NUNCA al repo (constitution IV).
.e2e/

# Estado runtime del bridge Hermes real (tokens de sesión en claro) —
# lo escribe el plugin enrolado en vivo; jamás al repo (constitution IV).
.state-hermes-bridge.json

# Spec 040: instaladores desktop construidos en el host (binarios de ~100-200 MB
# por plataforma — se sirven desde el volume, no viven en git).
installer-artifacts/

# Spec 040: resources horneados POR TENANT al build (binding de la org —
# los genera scripts/build_desktop_installers.py, jamás se commitean).
platform/installer-app/resources/
platform/installer-app/build/
